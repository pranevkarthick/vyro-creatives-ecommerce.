# Copy this file to .env and set your own values. Never commit .env.
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
BASE_URL=http://localhost:3000

# First startup can create an admin user if these are provided.
ADMIN_NAME=Vyro Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!

# Razorpay (leave blank to disable online checkout until configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: set to false to disable public registration
ALLOW_REGISTRATION=true
